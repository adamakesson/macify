#include <winver.h>
#include "version.h"

1 ICON "app.ico"
2 ICON "tray-dark.ico"
3 ICON "tray-light.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MACIFY_VERSION_NUM
PRODUCTVERSION MACIFY_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Macify"
      VALUE "ProductName", "Macify"
      VALUE "FileVersion", MACIFY_VERSION_STR
      VALUE "ProductVersion", MACIFY_VERSION_STR
      VALUE "OriginalFilename", "macify.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
